# Copy to .env (gitignored, loaded automatically). Never commit real secrets.

# --- Auth ---
# Used by BOTH the synthetic-data feature (raw Anthropic API) and the segmentation agent.
ANTHROPIC_API_KEY=sk-ant-...

# --- Survey database (research) ---
SURVEY_MONGO_URL=mongodb://user:password@host:port/research
SURVEY_MONGO_DB=research

# --- Synthetic-data feature ---
ANTHROPIC_MODEL=claude-opus-4-7
MAX_GENERATE_RESPONDENTS=50
GENERATE_WORKERS=5
PREVIEW_SAMPLE=10
PREVIEW_WORKERS=10

# --- Segmentation feature (Agent SDK) ---
SEGMENTATION_MODEL=claude-opus-5-5
SEGMENTATION_EFFORT=medium
FALLBACK_MODEL=claude-opus-4-8
# 0 = unlimited (no turn cap / no budget cap / no wall-clock timeout)
MAX_TURNS=0
MAX_BUDGET_USD=0
RUN_TIMEOUT_SECONDS=0
MAX_CONCURRENT_RUNS=2
MAX_UPLOAD_MB=50
SEGMENTATION_ROW_CAP=8000

# --- Server ---
# Must match the nginx upstream (proxy_pass http://127.0.0.1:PORT_NUMBER).
PORT_NUMBER=9260
DEV_MODE=true
RUNS_DIR=runs
UPLOADS_DIR=uploads

# --- MCP endpoint (/mcp/) ---
# Public origin (https://...) used in MCP links AND as the OAuth issuer, e.g.
# https://syntheticdata.ddns.net. Required for OAuth.
PUBLIC_BASE_URL=

# Preferred auth: OAuth 2.1 with Google Workspace sign-in. Create a "Web application"
# OAuth client in Google Cloud Console with authorized redirect URI
#   ${PUBLIC_BASE_URL}/oauth/google/callback
# Setting both values switches /mcp/ to OAuth and disables MCP_AUTH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Only verified Google Workspace accounts in these domains may connect (comma-separated).
MCP_ALLOWED_GOOGLE_DOMAINS=aimtechnologies.co
# Token lifetimes in seconds (access 1h, refresh 30d).
MCP_ACCESS_TOKEN_TTL=3600
MCP_REFRESH_TOKEN_TTL=2592000

# Legacy fallback when GOOGLE_OAUTH_* are unset: shared secret as Bearer / ?token=.
# Leave empty ONLY for localhost dev (open endpoint).
MCP_AUTH_TOKEN=
